#!/usr/bin/env bash
# Old name for bin/clued.
# Through any symlinks to this file (readlink -f is GNU, or macOS 12.3 and later).
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
exec "$(dirname "$self")/clued" "$@"
