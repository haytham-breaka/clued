#!/usr/bin/env bash
# clued: a chat app on top of a real Claude Code session (run headless underneath).
#   clued                 new session          clued -c           continue the last one
#   clued --resume [id]   pick or open one     any other flag     passed to claude
#   clued setup           install the optional extras (y/N for each)   clued setup --check  only their status
# /reload inside the app restarts it on the same session (the app exits 75; this loop starts it again).
# The older tmux layout (Claude Code's own screen with a threads panel beside it): clued-classic
# Runs on macOS's own bash 3.2 too: there an empty array expanded under set -u is an "unbound
# variable", so each array that can be empty goes through ${a[@]+"${a[@]}"}.
set -uo pipefail
# This file's real place, through any symlinks (readlink -f is GNU, or macOS 12.3 and later).
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
here="$(cd "$(dirname "$self")/.." && pwd)"
if [ "${1:-}" = setup ]; then
  shift
  exec node --no-warnings "$here/app/setup-cli.ts" "$@"
fi
args=("$@")
while true; do
  node --no-warnings "$here/app/main.ts" ${args[@]+"${args[@]}"}
  code=$?
  [ "$code" -eq 75 ] && [ -s "$HOME/.clued/reload" ] || exit "$code"
  # Same session, same other flags.
  keep=()
  skip=0
  for a in ${args[@]+"${args[@]}"}; do
    if [ "$skip" -eq 1 ]; then skip=0; continue; fi
    case "$a" in
      -c|--continue) ;;
      -r|--resume) skip=1 ;;
      *) keep+=("$a") ;;
    esac
  done
  args=(${keep[@]+"${keep[@]}"} --resume "$(cat "$HOME/.clued/reload")")
  rm -f "$HOME/.clued/reload"
done
